{
  "version": "1.1-dryrun",
  "date": "2026-08-20",
  "status": "PROPOSAL — nothing has been applied to Figma",
  "convention": "../docs/21-token-naming.md",
  "scope": "Semantic collection, COLOR only (138 variables). Primitives, Component and Typography are out of scope for 1.1.",

  "measurement": {
    "instrument": "_build/naming-analysis.js",
    "converged": true,
    "passesToAgreement": 2,
    "totalBindings": 10108,
    "coldPassUnderReport": "4183 on the first pass — 59% low. Never trust a single pass (00-principles §B4).",
    "tokens": 138,
    "usedInProduct": 48,
    "documentationSwatchesOnly": 58,
    "neverBoundAnywhere": 32,
    "duplicateValueGroups": 29,
    "headline": "90 of 138 semantic colour tokens (65%) do not appear on a single product screen."
  },

  "rename": [
    { "from": "color/wrap/default",        "to": "bg/canvas",        "prod": 89,   "note": "the page itself" },
    { "from": "color/wrap/subtle",         "to": "bg/subtle",        "prod": 111 },
    { "from": "color/wrap/card",           "to": "bg/surface",       "prod": 189,  "note": "'card' is a component; 'surface' is the role" },
    { "from": "color/surface/inverse",     "to": "bg/inverse",       "prod": 4 },
    { "from": "color/surface/popover",     "to": "bg/popover",       "prod": 0 },
    { "from": "color/surface/elevation/floating", "to": "bg/floating", "prod": 0 },
    { "from": "color/surface/elevation/menu",     "to": "bg/menu",     "prod": 0 },
    { "from": "color/surface/elevation/overlay",  "to": "bg/overlay",  "prod": 0 },

    { "from": "color/foreground/default",   "to": "fg/default",      "prod": 641 },
    { "from": "color/foreground/subtle",    "to": "fg/subtle",       "prod": 1639, "warn": "28 bindings are STROKES. They repoint to the new border/subtle." },
    { "from": "color/foreground/on-inverse","to": "fg/on-inverse",   "prod": 0 },

    { "from": "color/border/default",       "to": "border/default",  "prod": 503,  "warn": "88 bindings are FILLS on 1px shapes. Audit item, not a rename." },
    { "from": "color/border/strong",        "to": "border/strong",   "prod": 0 },
    { "from": "color/border/overlay-primary","to": "border/brand",   "prod": 32,   "note": "#06b6d480 — the translucent brand edge" },

    { "from": "color/shadow/key",           "to": "shadow/key",      "prod": 0 },
    { "from": "color/shadow/ambient",       "to": "shadow/ambient",  "prod": 0 },
    { "from": "color/border/focus",         "to": "shadow/focus",    "prod": 0,
      "HEADLINE": "0 stroke bindings, 12 effect bindings. This token has never once been a border. The name has been lying since it was created." },

    { "from": "color/interactive/primary-foreground",     "to": "fg/on-brand",     "prod": 70 },
    { "from": "color/overlay/brand",                      "to": "bg/brand-subtle", "prod": 28, "note": "#06b6d41a — 10%" },
    { "from": "color/interactive/primary-overlay-subtle", "to": "bg/brand-muted",  "prod": 32,
      "note": "#06b6d433 — 20%. It is currently called 'subtle' while being the STRONGER of the two brand tints. The ladder is corrected here." },
    { "from": "color/interactive/secondary-foreground",   "to": "fg/on-subtle",    "prod": 46 },

    { "from": "color/status/hover",    "to": "bg/hover",    "prod": 0 },
    { "from": "color/status/active",   "to": "bg/active",   "prod": 0 },
    { "from": "color/status/selected", "to": "bg/selected", "prod": 0 },
    { "from": "color/status/disabled", "to": "bg/disabled", "prod": 0 },

    { "from": "color/feedback/success",  "to": "bg/success-subtle" },
    { "from": "color/feedback/warning",  "to": "bg/warning-subtle" },
    { "from": "color/feedback/info",     "to": "bg/info-subtle" },
    { "from": "color/feedback/neutral",  "to": "bg/neutral-subtle" },
    { "from": "color/feedback/danger",   "to": "bg/danger-subtle" },
    { "from": "color/feedback/success-emphasis", "to": "fg/success" },
    { "from": "color/feedback/warning-emphasis", "to": "fg/warning" },
    { "from": "color/feedback/info-emphasis",    "to": "fg/info" },
    { "from": "color/feedback/neutral-emphasis", "to": "fg/neutral" },
    { "from": "color/feedback/danger-emphasis",  "to": "fg/danger", "prod": 2 },

    { "from": "color/income/surface",    "to": "bg/income-subtle",    "prod": 8 },
    { "from": "color/expense/surface",   "to": "bg/expense-subtle" },
    { "from": "color/expense/foreground","to": "fg/expense-strong" },
    { "from": "color/net/default",       "to": "bg/net",              "prod": 10 },
    { "from": "color/net/foreground",    "to": "fg/net",              "prod": 5 },
    { "from": "color/net/surface",       "to": "bg/net-subtle" },
    { "from": "color/tax/default",       "to": "bg/tax",              "prod": 10 },
    { "from": "color/tax/foreground",    "to": "fg/tax",              "prod": 10 },
    { "from": "color/tax/surface",       "to": "bg/tax-subtle" },
    { "from": "color/provision/foreground", "to": "fg/provision-strong", "prod": 9 },
    { "from": "color/provision/surface",    "to": "bg/provision-subtle" },
    { "from": "color/danger/foreground",    "to": "fg/danger-strong" },

    { "from": "color/account/foreground", "to": "fg/account",     "prod": 100 },
    { "from": "color/account/surface",    "to": "bg/account",     "prod": 93 },
    { "from": "color/account/border",     "to": "border/account", "prod": 92 },
    { "from": "color/live/default",       "to": "bg/live",        "prod": 9 },
    { "from": "color/live/ring",          "to": "bg/live-ring",   "prod": 9 },
    { "from": "color/logo/bg",            "to": "brand/logo-bg",  "prod": 30 },
    { "from": "color/logo/primary",       "to": "brand/logo-mark","prod": 30 }
  ],

  "split": [
    {
      "from": "color/interactive/primary",
      "why": "One token painting three properties: 234 fills, 185 strokes, 18 text. This is the single largest architectural defect in the collection — every one of those 437 bindings is currently unable to move independently.",
      "into": [
        { "to": "bg/brand",           "property": "fill",   "bindings": 234 },
        { "to": "border/brand-strong","property": "stroke", "bindings": 185 },
        { "to": "fg/brand",           "property": "text",   "bindings": 18 }
      ],
      "sameValueToday": "#0e7490 — the split costs nothing visually and buys the ability to darken a border without darkening the button."
    },
    {
      "from": "color/foreground/placeholder",
      "why": "The Component collection already aliases this token as 'disabled'. Placeholder text and disabled text are two contracts sharing one value by accident.",
      "into": [
        { "to": "fg/placeholder", "bindings": 55 },
        { "to": "fg/disabled",    "bindings": 41 }
      ],
      "sameValueToday": "#94a3b8"
    },
    {
      "from": "color/expense/default",
      "why": "5 text bindings, 14 fill bindings.",
      "into": [ { "to": "fg/expense", "bindings": 5 }, { "to": "bg/expense", "bindings": 14 } ],
      "sameValueToday": "#ef4444"
    },
    {
      "from": "color/provision/default",
      "why": "14 text bindings, 14 fill bindings — a dead-even tie.",
      "into": [ { "to": "fg/provision", "bindings": 14 }, { "to": "bg/provision", "bindings": 14 } ],
      "sameValueToday": "#059669"
    },
    {
      "from": "color/income/default",
      "why": "Used as text, unlike its siblings.",
      "into": [ { "to": "fg/income", "bindings": 4 }, { "to": "bg/income", "bindings": 2 } ],
      "sameValueToday": "#0891b2",
      "FAMILY_DEFECT": "In the tax and net families, '/default' is the SOLID BACKGROUND. In the income family, '/default' is the TEXT COLOUR. Same suffix, opposite property, adjacent tokens. This is the clearest single argument for property-first naming."
    }
  ],

  "merge": [
    { "from": ["color/wrap/container"], "to": "bg/canvas", "value": "#f8fafc", "prod": 21, "why": "identical value, identical job" },
    { "from": ["color/foreground/on-card", "color/foreground/on-popover"], "to": "fg/default", "value": "#0f172a", "prod": 141,
      "why": "on-card and on-popover both resolve to exactly what fg/default already is",
      "PENDING": "confirm the Dark mode values match before merging — light mode agreement is not enough" },
    { "from": ["color/surface/raised", "color/surface/elevation/raised"], "to": "bg/raised", "value": "#ffffff", "prod": 16,
      "why": "two tokens, one rung", "PENDING": "confirm Dark values" },
    { "from": ["color/surface/sunken", "color/interactive/secondary"], "to": "bg/subtle", "value": "#f1f5f9",
      "PENDING": "confirm Dark values" },
    { "from": ["color/danger/default"], "to": "fg/danger", "value": "#dc2626", "why": "identical to feedback/danger-emphasis" },
    { "from": ["color/danger/surface"], "to": "bg/danger-subtle", "value": "#fef2f2" },
    { "from": ["color/income/foreground"], "to": "fg/income-strong", "value": "#0e7490",
      "warn": "this value is ALSO color/interactive/primary. Income green-lighting the brand cyan is probably an accident — confirm with Alfredo." }
  ],

  "delete": [
    { "token": "color/brand/default",  "value": "#e0f2fe",
      "HEADLINE": "The two tokens literally named 'brand' hold SKY BLUE (#e0f2fe / #0284c7). Neto's brand is cyan (#0e7490 / #06b6d4). Nothing binds them. They are a leftover from a palette that is no longer the brand." },
    { "token": "color/brand/emphasis", "value": "#0284c7", "see": "color/brand/default" },
    { "token": "color/destructive/default",    "value": "#dc2626", "why": "duplicate of feedback/danger-emphasis" },
    { "token": "color/destructive/foreground", "value": "#ffffff", "why": "duplicate of interactive/primary-foreground" },
    { "token": "color/interactive/accent",            "value": "#f1f5f9", "why": "duplicate of wrap/subtle, never bound in product" },
    { "token": "color/interactive/accent-foreground", "value": "#1e293b", "why": "duplicate of interactive/secondary-foreground" },
    { "token": "color/border/input",           "value": "#e2e8f0", "why": "duplicate of border/default, never bound anywhere" },
    { "token": "color/foreground/danger-inverse", "why": "never bound anywhere" },
    { "token": "color/surface/overlay", "why": "never bound; bg/overlay covers it" },
    { "token": "color/surface/scrim",   "why": "never bound; duplicate of overlay/scrim" },
    { "token": "color/overlay/danger",  "why": "never bound" },
    { "token": "color/overlay/info",    "why": "never bound" },
    { "token": "color/overlay/success", "why": "never bound" },
    { "token": "color/overlay/warning", "why": "never bound" },
    { "token": "color/overlay/frosted", "why": "never bound; no frosted surface exists in the product" },
    { "token": "color/overlay/skeleton","why": "never bound; the Skeleton component paints with border/default" },
    { "token": "color/overlay/focus",   "why": "never bound; shadow/focus is the real focus token" },
    { "token": "color/overlay/disabled","why": "never bound; bg/disabled covers it" },
    { "token": "color/overlay/scrim-heavy", "why": "never bound; one scrim is enough until a second is needed" }
  ],

  "reserve": [
    { "tokens": ["color/categorical/1..5"], "to": "chart/categorical/1..5",
      "why": "never bound — but Phase 4 builds three annual charts and a distribution bar, which is exactly what these are for. Deleting them would mean re-minting them in six weeks. Keep, rename, and document the intended use." },
    { "tokens": ["color/sequential/1..5"],  "to": "chart/sequential/1..5", "see": "categorical" },
    { "tokens": ["account-accent/*"],       "to": "account/{amber,emerald,lime,pink,purple,sky}",
      "why": "5 of 6 never bound because only one account exists in the mocks. This is the palette a user picks from — absence of use is not absence of purpose." },
    { "tokens": ["color/overlay/hover", "color/overlay/pressed", "color/overlay/selected"],
      "to": "bg/overlay-{hover,pressed,selected}",
      "why": "never bound, but the translucent state layer is the correct model for interaction states on coloured surfaces. Phase 3 needs them. Keep 3, delete the other 9." },
    { "tokens": ["color/overlay/scrim"], "to": "bg/scrim", "why": "the modal scrim; Overlays are Phase 4" }
  ],

  "identityFamilies": {
    "rule": "Exempt from property-first — see docs/21-token-naming.md Rule 2. Their intent is WHICH THING, not WHICH PROPERTY.",
    "rename": [
      { "from": "color/category/{name}/default", "to": "category/{name}/accent",
        "why": "'default' says nothing. Measured: these paint the icon glyph (2–50 bindings) and the solid dot. 'accent' names the job.",
        "names": ["bank","connectivity","family","food","health","home","insurance","other","recreation","savings","shopping","tax","transit","travel","work"] },
      { "from": "color/category/{name}/surface", "to": "category/{name}/surface", "why": "already correct; only the prefix drops" }
    ]
  },

  "new": [
    { "token": "border/subtle", "why": "28 stroke bindings currently sit on fg/subtle. They need somewhere legitimate to go.", "value": "= fg/subtle today" },
    { "token": "fg/on-solid",   "why": "white text on any solid semantic fill. Currently every family re-derives it or borrows destructive/foreground.", "value": "#ffffff" }
  ],

  "notApplied": true,
  "nextStep": "Alfredo reviews naming-proposal.md. Phase 1.2 applies only what he approves — it is the one step in the roadmap that cannot be undone cheaply."
}
